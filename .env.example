# Commerce Copilot 环境配置示例（真实 .env 不入库）
# 复制为 .env 后按需修改

APP_ENV=dev
HOST=127.0.0.1
PORT=8000

# 数据目录：E 盘空间不足，故指向 D 盘
DATA_DIR=D:\commerce-copilot-data

# 鉴权（PoC 默认值，请自行更换）
JWT_SECRET=commerce-copilot-poc-secret-change-me

# LLM：OpenAI 兼容接口。填了 Key 自动走真实模型，留空自动规则降级
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30
LLM_MAX_TOKENS=800

# 向量：auto / bge / hash
EMBEDDING_MODE=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH=32
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=D:\hf-cache

# 检索参数
BM25_TOP_K=30
VECTOR_TOP_K=30
FINAL_TOP_K=3
RRF_K=60

# 业务参数
MAX_CLARIFY_ROUNDS=2
MAX_GRAPH_STEPS=12
HIGH_VALUE_THRESHOLD=1000
